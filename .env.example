# Published Google Sheet CSV URL (optional; the app includes a 30-dish seed catalog)
VITE_CATALOG_URL=

# Google Places API (New) browser key. Restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
VITE_PLACES_PROVIDER=osm

# Optional override for the bundled 4.284-second chest-opening MP3.
# Default: /assets/audio/chest-opening.mp3
VITE_CHEST_OPENING_AUDIO_URL=

# Game economy defaults
VITE_DAILY_KEYS=10
VITE_CHEST_COST=1
VITE_APP_TIME_ZONE=Asia/Ho_Chi_Minh
