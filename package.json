{
  "name": "soul-of-meal",
  "packageManager": "pnpm@10.34.3",
  "private": true,
  "version": "3.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config dev/vite.dev.config.ts",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config dev/vitest.config.ts",
    "validate:catalog": "node dev/tools/validate-catalog.mjs",
    "benchmark:autochess": "node dev/tools/benchmark-autochess.mjs",
    "typecheck:dev": "tsc --noEmit -p dev/tsconfig.json",
    "release:records": "node dev/tools/release-records.mjs",
    "release:verify": "node dev/tools/release-records.mjs --check",
    "release:size": "node dev/tools/release-size.mjs",
    "release:source": "python3 dev/tools/pack-release.py",
    "release:web": "python3 dev/tools/pack-release.py --dist"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "gsap": "^3.15.0",
    "papaparse": "^5.7.0",
    "pixi.js": "^8.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.1"
  }
}
