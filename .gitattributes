*.aac                filter=lfs diff=lfs merge=lfs -text
*.ogg                filter=lfs diff=lfs merge=lfs -text
*.m4a                filter=lfs diff=lfs merge=lfs -text
*.wma                filter=lfs diff=lfs merge=lfs -text
*.aiff               filter=lfs diff=lfs merge=lfs -text

# Small runtime audio assets must be committed as normal blobs so Vercel can
# serve their contents without requiring Git LFS.
public/assets/audio/** -filter -diff -merge -text

# Runtime food and event WebP assets are normal Git blobs in this project.
# Keep them outside LFS so the Vercel checkout serves the actual image bytes.
public/assets/food/** -filter -diff -merge -text
public/assets/events/** -filter -diff -merge -text
public/assets/tcg/fx/** -filter -diff -merge -text
public/assets/tcg/story/** -filter -diff -merge -text

